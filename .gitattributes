* text=auto eol=lf

# Preserve the exact bytes referenced by the vehicle-audio validation registry.
reversing/VehAudioFinal4/validation-summary.json -text whitespace=cr-at-eol

# Preserve extracted evidence and tested fixture bytes; do not reformat to remove EOF blanks.
reversing/**/LiveComparison.hpp whitespace=-blank-at-eof
reversing/**/*.py whitespace=-blank-at-eof
reversing/**/*.txt whitespace=-trailing-space,-blank-at-eof
reversing/**/*-snapshot.cpp whitespace=-blank-at-eof
reversing/**/*-snapshot.h whitespace=-blank-at-eof

# Keep archived hook-unlock evidence byte-for-byte identical to its build manifests.
reversing/HookUnlockAudio/runs/** -text whitespace=-trailing-space,-blank-at-eof
reversing/HookUnlockGame/runs/** -text whitespace=-trailing-space,-blank-at-eof
reversing/HookUnlockFinal/runs/** -text whitespace=-trailing-space,-blank-at-eof
