+    int32 scale = Heli83GFtol(Veh83DMul(static_cast<double>(ratio), Veh83DDiv(1000.0, static_cast<double>(autoPilot.m_speed))));
+    autoPilot.m_nSpeedScaleFactor = static_cast<uint32>(scale);
+    if (!(scale > 10)) {
+        scale = 10;
+    }
+    autoPilot.m_nSpeedScaleFactor = static_cast<uint32>(scale);
 }
 
 // 0x426EF0
