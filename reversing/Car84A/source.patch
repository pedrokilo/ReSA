+            lanesNext = below ? (flags >> 3) & 7 : flags & 7;
+        }
+    }
+
+    // Direcciones del enlace actual y del siguiente por el signo del tramo: (byte * 0.01f) * signo, cada operacion redondeada a float
+    constexpr float kHundredth = std::bit_cast<float>(0x3C23D70Au); // 0x858C58 (0.01f)
+    constexpr float kEighth = 0.125f;                               // 0x858C48
+    const float signCurrentF = static_cast<float>(static_cast<int8>(autoPilot._smthCurr));
