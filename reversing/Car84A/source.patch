+    const float offsetNext = reinterpret_cast<const CCarPathLink*>(arrivalLink)->OneWayLaneOffset();
+    const float widthNext = (offsetNext + static_cast<float>(static_cast<int8>(autoPilot.m_nNextLane))) * kLaneWidth;
