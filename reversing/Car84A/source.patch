+        const CNodeAddress start = autoPilot.m_startingRouteNode;
+        const CNodeAddress current = autoPilot.m_currentAddress;
+        const uint8* const startNode = nodeAt(start.m_wAreaId, start.m_wNodeId);
+        const uint8* const currentNode = nodeAt(current.m_wAreaId, current.m_wNodeId);
