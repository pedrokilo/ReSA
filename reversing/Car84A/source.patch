+
+    // Candidato i del nodo siguiente: m_pNodeLinks[area][base + FindSequenceElement(i)] y su enlace de navegacion m_pNaviLinks (misma posicion)
+    const auto baseIndex = [&](int32 i) { return static_cast<int32>(*reinterpret_cast<const int16*>(nodeAt(next.m_wAreaId, next.m_wNodeId) + 0x10)) + FindSequenceElement(i); };
