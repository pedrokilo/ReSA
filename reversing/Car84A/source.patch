+        const uint32 kind = nodeAt(start.m_wAreaId, start.m_wNodeId)[0x1A] >> 4;
+        if (kind == 10) {
+            const uint8 status = raw[0x36];
+            autoPilot.m_nTempAction = static_cast<eAutoPilotTempAction>(1);
+            const uint32 until = CTimer::GetTimeInMS() + 0x2710;
+            autoPilot.m_nTempActionTime = until;
+            if ((status & 0xF8) == 0x10) {
+                autoPilot.ModifySpeed(0.0f);
+            }
+        } else if (kind == 1 || kind == 2) {
+            raw[0x36] = (raw[0x36] & 7) | 0x18;
+            autoPilot.m_nTempAction = TEMPACT_NONE;
+            autoPilot.m_nTimeToStartMission = CTimer::GetTimeInMS() + 0x7D0;
+            const uint32 stamp = CTimer::GetTimeInMS();
+            autoPilot.m_nCarMission = static_cast<eCarMission>(kind == 2 ? 0x2D : 0x2E);
+            autoPilot.m_nTimeSwitchedToRealPhysics = stamp;
+            raw[0xB8] = 0;
+            autoPilot.m_nCarDrivingStyle = static_cast<eCarDrivingStyle>(0);
+        }
+    }
+    {
+        const CNodeAddress current = autoPilot.m_currentAddress;
+        if ((nodeAt(current.m_wAreaId, current.m_wNodeId)[0x1A] & 0xF0) == 0x90 && static_cast<uint8>(vehicle->m_nCreatedBy) != 2) {
+            const uint8 status = raw[0x36];
+            autoPilot.m_nTempAction = static_cast<eAutoPilotTempAction>(1);
+            const uint32 until = CTimer::GetTimeInMS() + 0x1194;
+            autoPilot.m_nTempActionTime = until;
+            if ((status & 0xF8) == 0x10) {
+                autoPilot.ModifySpeed(0.0f);
+            }
+        }
+    }
+
+    // Se desplazan los enlaces, los signos y el carril (anterior <- actual <- siguiente <- elegido); field_C acumula el factor de velocidad
+    {
+        const CCarPathLinkAddress currentOld = autoPilot.m_nCurrentPathNodeInfo;
+        const uint32 scale = autoPilot.m_nSpeedScaleFactor;
+        const CCarPathLinkAddress nextOld = autoPilot.m_nNextPathNodeInfo;
+        const int32 sum = static_cast<int32>(static_cast<uint32>(autoPilot.field_C) + scale);
+        const int8 signCurrent = autoPilot._smthCurr;
+        autoPilot.m_nPreviousPathNodeInfo = currentOld;
+        const int8 signNext = autoPilot._smthNext;
+        autoPilot.m_nCurrentPathNodeInfo = nextOld;
+        const int8 nextLane = autoPilot.m_nNextLane;
+        autoPilot._smthCurr = signNext;
+        autoPilot.field_C = sum;
+        autoPilot._smthPrev = signCurrent;
+        autoPilot.m_nCurrentLane = nextLane;
+        autoPilot.m_nNextPathNodeInfo = chosenLink;
+    }
+    int32 lanesNext;
+    {
