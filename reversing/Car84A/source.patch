+        const uint8 flags = linkBytes[0xB];
+        const bool toNext = attachedTo(linkBytes, next);
+        const bool firstFree = toNext ? (flags & 0x38) == 0 : (flags & 7) == 0;
+        const bool secondFree = toNext ? (flags & 7) == 0 : (flags & 0x38) == 0;
+        if (!IsThisAnAppropriateNode(vehicle, previous, next, candidate, firstFree)) {
+            continue;
+        }
+        if (!(static_cast<uint8>(direction) & mask)) {
+            continue;
+        }
+        if (!oneWay || !secondFree) {
+            chosenLink = link;
+            chosen = true;
+            break;
+        }
+    }
+    if (!chosen) {
+        for (int32 i = 0; i < numLinks; ++i) {
+            const int32 index = baseIndex(i);
+            const CNodeAddress candidate = ThePaths.m_pNodeLinks[next.m_wAreaId][index];
+            autoPilot.m_startingRouteNode = candidate;
+            if (!ThePaths.m_pPathNodes[candidate.m_wAreaId]) {
+                continue;
+            }
+            const CCarPathLinkAddress link = ThePaths.m_pNaviLinks[next.m_wAreaId][index];
+            if (!ThePaths.m_pPathNodes[link.m_wAreaId]) {
+                continue;
+            }
+            const bool bad = badLink(link);
+            if (candidate.m_wAreaId == previous.m_wAreaId && candidate.m_wNodeId == previous.m_wNodeId) {
+                continue;
+            }
+            if (bad) {
+                continue;
+            }
+            if (!(nodeAt(candidate.m_wAreaId, candidate.m_wNodeId)[0x18] & 0x20) || (nodeAt(previous.m_wAreaId, previous.m_wNodeId)[0x18] & 0x20)) {
+                chosenLink = link;
+                chosen = true;
+                break;
+            }
+        }
+    }
+    if (!chosen) {
+        for (int32 i = 0; i < numLinks; ++i) {
+            const int32 index = baseIndex(i);
+            const CNodeAddress candidate = ThePaths.m_pNodeLinks[next.m_wAreaId][index];
+            autoPilot.m_startingRouteNode = candidate;
+            if (!ThePaths.m_pPathNodes[candidate.m_wAreaId]) {
+                continue;
+            }
+            const CCarPathLinkAddress link = ThePaths.m_pNaviLinks[next.m_wAreaId][index];
+            if (!ThePaths.m_pPathNodes[link.m_wAreaId]) {
+                continue;
+            }
+            const bool bad = badLink(link);
+            if (candidate.m_wAreaId == previous.m_wAreaId && candidate.m_wNodeId == previous.m_wNodeId) {
+                continue;
+            }
+            if (!bad) {
+                chosenLink = link;
+                chosen = true;
+                break;
+            }
+        }
+    }
+    if (!chosen) {
+        autoPilot.m_startingRouteNode = previous;
+        chosenLink = autoPilot.m_nNextPathNodeInfo;
+    }
+
+    // Volver al nodo anterior: estado 3 (salvo que ya lo este), sin accion temporal y a esperar 2 s
+    {
+        const CNodeAddress start = autoPilot.m_startingRouteNode;
+        if (previous.m_wAreaId == start.m_wAreaId && previous.m_wNodeId == start.m_wNodeId && (raw[0x36] & 0xF8) != 0x18) {
+            raw[0x36] = (raw[0x36] & 7) | 0x18;
+            autoPilot.m_nTempAction = TEMPACT_NONE;
+            autoPilot.m_nTimeToStartMission = CTimer::GetTimeInMS() + 0x7D0;
+            autoPilot.m_nTimeSwitchedToRealPhysics = CTimer::GetTimeInMS();
+            raw[0xB8] = 0;
+        }
+    }
+    {
