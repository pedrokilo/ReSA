+    const float arrivalX = static_cast<float>(*reinterpret_cast<const int16*>(arrivalLink)) * kEighth + widthNext * nextDirY;
+    const uint8* const departureLink = linkAt(autoPilot.m_nCurrentPathNodeInfo);
+    const float departureY = static_cast<float>(*reinterpret_cast<const int16*>(departureLink + 2)) * kEighth - widthCurrent * currentDirX;
+    const float departureX = static_cast<float>(*reinterpret_cast<const int16*>(departureLink)) * kEighth + widthCurrent * currentDirY;
+    const CVector departure{ departureX, departureY, 0.0f };
+    const CVector arrival{ arrivalX, arrivalY, 0.0f };
+    const float ratio = CCurves::CalcSpeedScaleFactor(departure, arrival, currentDirX, currentDirY, nextDirX, nextDirY); // 0x43C710
