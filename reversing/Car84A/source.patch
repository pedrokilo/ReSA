+    // Como el original (0x42DE80..0x42EC81, cdecl, void). srand del EXE (0x821B11) con la palabra +0x45E si no es 0; el nodo actual (+0x390), el siguiente (+0x394) y el enlace siguiente (+0x3A6) deben
+    // tener su area cargada (comprobada en m_pPathNodes, tambien la del enlace) o se sale sin tocar nada. "Un solo sentido" y el numero de carriles salen del enlace siguiente (+0xB: bits 0-2 / 3-5 segun
+    // si apunta al nodo siguiente); la mascara de direcciones permitidas sale del carril siguiente (+0x3B8: 4 en el carril 0, 2 en el ultimo, 1 si hay menos de 3 o ninguna). Anterior (+0x398) = actual,
+    // actual = siguiente y, si ThisVehicleShouldTryNotToTurn, mascara 1. InitSequence(enlaces del nodo siguiente) y tres barridos en el orden de FindSequenceElement: 1) nodo candidato (+0x394) con el area
+    // cargada, FindPathDirection(anterior, actual, candidato), enlace de navegacion con el area cargada, no (estado 2 y sentido contrario), IsThisAnAppropriateNode, (direccion & mascara) y (no un solo
+    // sentido o el enlace no es de un solo sentido); 2) candidato distinto del anterior, enlace valido y bueno y (candidato sin el bit 0x20 o anterior con el); 3) igual sin la comprobacion del bit; si nada
+    // sirve, vuelve al nodo anterior con el enlace siguiente de entrada. Si el elegido es el anterior y el estado no es 3: estado 3, espera de 2 s. Tipos del nodo elegido (+0x1A >> 4): 1 y 2 (estado 3,
+    // mision 46 / 45, estilo 0) y 10 (accion temporal 1 durante 10 s y ModifySpeed(0) en estado 2); el tipo 9 del nodo actual (no vehiculo de mision) lo mismo 4,5 s. Desplaza los enlaces (anterior <-
+    // actual <- siguiente <- elegido) y los signos, calcula los carriles y, en estado 2, la x87 (24 bits: cada operacion se redondea a float, ver X87Math) del punto de salida y de llegada del tramo.
+    auto* const raw = reinterpret_cast<uint8*>(vehicle);
+    auto& autoPilot = vehicle->m_autoPilot;
+    const auto exeRand = reinterpret_cast<int(__cdecl*)()>(0x821B1E);
+    const auto nodeAt = [](uint16 area, uint16 node) { return reinterpret_cast<const uint8*>(ThePaths.m_pPathNodes[area]) + static_cast<size_t>(node) * 0x1C; };
+    const auto linkAt = [](CCarPathLinkAddress address) { return reinterpret_cast<const uint8*>(ThePaths.m_pNaviNodes[address.m_wAreaId]) + static_cast<size_t>(address.m_wCarPathLinkId) * 0xE; };
+    const auto attachedTo = [](const uint8* link, CNodeAddress node) { return *reinterpret_cast<const uint16*>(link + 4) == node.m_wAreaId && *reinterpret_cast<const uint16*>(link + 6) == node.m_wNodeId; };
+    if (const uint16 seed = *reinterpret_cast<const uint16*>(raw + 0x45E)) {
+        reinterpret_cast<void(__cdecl*)(uint32)>(0x821B11)(seed);
+    }
+    const CNodeAddress previous = autoPilot.m_currentAddress;
+    if (!ThePaths.m_pPathNodes[previous.m_wAreaId]) {
+        return;
+    }
+    const CNodeAddress next = autoPilot.m_startingRouteNode;
+    if (!ThePaths.m_pPathNodes[next.m_wAreaId]) {
