+namespace {
+// fld dword + fstp dword del x87: un NaN senalizador sale silenciado (bit 22); el resto de patrones (subnormales incluidos) se conserva.
+inline uint32 Car84FQuiet(uint32 bits) {
+    return (bits & 0x7F800000u) == 0x7F800000u && (bits & 0x007FFFFFu) ? (bits | 0x00400000u) : bits;
+}
+// Posicion (x, y, z) de un vehiculo recien creado: matriz +0x30/+0x34/+0x38 (x como palabra, y y z por la x87) o placement +4/+8/+0xC si no hay matriz (+0x14)
+inline void Car84FSetPosition(CVehicle* car, uint32 xBits, uint32 yBits, uint32 zBits) {
+    uint8* const matrix = Car75Raw<uint8*>(car, 0x14);
+    if (matrix) {
+        Car75Raw<uint32>(matrix, 0x30) = xBits;
+        Car75Raw<uint32>(matrix, 0x34) = Car84FQuiet(yBits);
+        Car75Raw<uint32>(matrix, 0x38) = Car84FQuiet(zBits);
+    } else {
+        Car75Raw<uint32>(car, 0x08) = Car84FQuiet(yBits);
+        Car75Raw<uint32>(car, 0x04) = xBits;
+        Car75Raw<uint32>(car, 0x0C) = Car84FQuiet(zBits);
+    }
+}
+// Suelo bajo el punto (bits): dos disparos verticales (+1000 y -1000, solo edificios y objetos ficticios); 1e9 (0x4E6E6B28) si no hay golpe. El segundo golpe sustituye al primero si |hit - z| < |suelo - z|,
+// con las restas de la x87 a 24 bits (un empate tras el redondeo no lo sustituye) y comparaciones ordenadas (un NaN no sustituye)
+uint32 Car84FFindGround(const CVector& point) {
+    uint32 groundBits = 0x4E6E6B28u;
+    CColPoint colPoint;
+    CEntity* hitEntity;
+    if (CWorld::ProcessVerticalLine(point, 1000.0f, colPoint, hitEntity, true, false, false, false, true, false, nullptr)) { // 0x5674E0
+        groundBits = Car75Bits(colPoint.m_vecPoint.z);
+    }
+    if (CWorld::ProcessVerticalLine(point, -1000.0f, colPoint, hitEntity, true, false, false, false, true, false, nullptr)) {
+        const uint32 hitBits = Car75Bits(colPoint.m_vecPoint.z);
+        double hitDistance = Veh83DSub(std::bit_cast<float>(hitBits), point.z);
+        if (hitDistance < 0.0) {
+            hitDistance = -hitDistance;
+        }
+        double groundDistance = Veh83DSub(std::bit_cast<float>(groundBits), point.z);
+        if (groundDistance < 0.0) {
+            groundDistance = -groundDistance;
+        }
+        if (hitDistance < groundDistance) {
+            groundBits = hitBits;
+        }
+    }
+    return groundBits;
+}
+// `delete` con el destructor virtual por la tabla (ranura 0, indicador 1), como el EXE: el tipo dinamico no se conoce aqui
+__declspec(noinline) void Car84FDelete(CVehicle* vehicle) {
+    delete vehicle;
+}
+// Altura (z / 8) de un nodo de carreteras: palabra con signo +0x0C del nodo, convertida y multiplicada por 0.125 en el registro x87
+inline double Car84FNodeHeight(const CNodeAddress& node) {
