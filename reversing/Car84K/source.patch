+        return;
+    }
+    CVector pos;
+    std::memcpy(&pos, reinterpret_cast<const uint8*>(fire) + 4, sizeof(CVector));
+    if (GenerateOneEmergencyServicesCar(reinterpret_cast<const uint32*>(0x8A5AD4)[level], pos)) {
+        LastTimeFireTruckCreated = int32(CTimer::GetTimeInMS());
+    }
 }
 
