+    unsigned long long bits;
+    memcpy(&bits, &v, 8);
+    if (((bits >> 52) & 0x7FF) >= 0x43E) {
+        return 0;
+    }
+    long long truncated = static_cast<long long>(v);
+    if (static_cast<double>(truncated) > v) {
