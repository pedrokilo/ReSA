+namespace {
+// Integer square root, no CRT/game sqrt delegation. For finite binary32 input,
+// q is floor(sqrt(rad)); rad > q*q+q decides the correctly rounded root.
+float FormationCppSqrt24(float input) {
+    const uint32 bits = std::bit_cast<uint32>(input);
+    const uint32 fraction = bits & 0x7FFFFFu;
+    const uint32 exponent = (bits >> 23) & 0xFFu;
+    if ((bits & 0x7FFFFFFFu) == 0) return input;
+    if (exponent == 0xFFu) {
+        if (fraction) return std::bit_cast<float>(bits | 0x00400000u);
+        return bits >> 31 ? std::bit_cast<float>(0xFFC00000u) : input;
+    }
+    if (bits >> 31) return std::bit_cast<float>(0xFFC00000u);
+    uint32 mantissa = fraction;
+    int32 power = -126;
+    if (exponent) { mantissa |= 0x800000u; power = int32(exponent) - 127; }
+    else while (mantissa < 0x800000u) { mantissa <<= 1; --power; }
+    const int32 rootPower = power >= 0 ? power / 2 : -((-power + 1) / 2);
+    const uint32 parity = uint32(power - 2 * rootPower);
+    const uint64 rad = uint64(mantissa) << (23u + parity);
+    uint64 remainder = rad, root = 0, step = uint64(1) << 62;
+    while (step > remainder) step >>= 2;
+    while (step) {
+        if (remainder >= root + step) {
+            remainder -= root + step;
+            root = (root >> 1) + step;
+        } else root >>= 1;
+        step >>= 2;
+    }
+    if (rad > root * root + root) ++root;
+    int32 outputPower = rootPower;
+    if (root == 0x1000000u) { root >>= 1; ++outputPower; }
+    return std::bit_cast<float>((uint32(outputPower + 127) << 23) | (uint32(root) & 0x7FFFFFu));
+}
+float FormationCppAdd24(float a, float b) { volatile float out = a + b; return out; }
+float FormationCppSub24(float a, float b) { volatile float out = a - b; return out; }
+float FormationCppMul24(float a, float b) { volatile float out = a * b; return out; }
+}
