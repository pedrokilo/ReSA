+// 0x69B1B0. PC24/RCnearest, bounded finite corpus; other x87 modes not certified.
+int32 CFormation::FindNearestFreeDestination(CVector origin, float* total) {
+    float minimum = 10000000.0f; // Exact EXE float at 0x86D270.
+    int32 selected = -1;
+    const int32 count = std::bit_cast<int32>(m_Destinations.m_Count);
+    for (int32 i = 0; i < count; ++i) {
+        if (m_Destinations.m_PointHasBeenClaimed[i]) continue;
+        const auto point = m_Destinations.m_Points[size_t(i)];
+        const float deltaX = FormationCppSub24(point.x, origin.x);
+        const float deltaY = FormationCppSub24(point.y, origin.y);
+        const float deltaZ = FormationCppSub24(point.z, origin.z);
+        const float squareZ = FormationCppMul24(deltaZ, deltaZ);
+        const float squareY = FormationCppMul24(deltaY, deltaY);
+        const float squareX = FormationCppMul24(deltaX, deltaX);
+        const float squareZY = FormationCppAdd24(squareZ, squareY);
+        const float squared = FormationCppAdd24(squareZY, squareX);
+        const float distance = FormationCppSqrt24(squared);
+        // Native test AH,5 / JP rejects greater, equal and unordered values.
+        if (distance < minimum) {
+            minimum = distance;
+            selected = i;
+        }
+    }
+    *total = FormationCppAdd24(minimum, *total);
+    return selected;
+}
