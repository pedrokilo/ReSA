+// The PC EXE uses its own CRT heap. These are typed library calls, not game-function bridges.
+__forceinline void* Memory9NativeMalloc(uint32 size) {
+    using Function = void* (__cdecl*)(uint32);
+    return reinterpret_cast<Function>(uintptr_t{0x824257})(size);
