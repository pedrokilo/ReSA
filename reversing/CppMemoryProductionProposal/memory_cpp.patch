+__forceinline uint8* Memory9NativeRealloc(void* memory, uint32 size) {
+    using Function = uint8* (__cdecl*)(void*, uint32);
+    return reinterpret_cast<Function>(uintptr_t{0x824269})(memory, size);
+}
+__forceinline void Memory9NativeFree(void* memory) {
+    using Function = void (__cdecl*)(void*);
+    reinterpret_cast<Function>(uintptr_t{0x82413F})(memory);
 }
