+uint8* CMemoryMgr::MallocAlign(uint32 size, uint32 align, uint32 nHint) {
+    // Unsigned x86 arithmetic reproduces ADD/LEA wrapping before AND.
+    const uint32 requested = size + align;
+    void* const base = Memory9NativeMalloc(requested);
+    const uint32 baseAddress = static_cast<uint32>(reinterpret_cast<uintptr_t>(base));
+    const uint32 alignedAddress = (baseAddress + align) & ~(align - uint32{1});
+    auto* const result = reinterpret_cast<uint8*>(static_cast<uintptr_t>(alignedAddress));
+    *reinterpret_cast<void**>(result - sizeof(void*)) = base;
+    return result;
