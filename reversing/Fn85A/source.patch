+// 0x447720
+// Como el original (0x447720..0x447783): sin vehiculo es falso; el indice de manejo es el byte +0x4A de la informacion del modelo (solo el byte bajo) y las banderas de modelo son el dword +0xD0 de su entrada de la tabla de
+// manejo (0xC2B9DC + 0xE0 * indice; el indice puede salir de las 210 entradas del vector, el EXE no lo comprueba). Garaje 36: exige la bandera 0x2000000; 37: la 0x4000000; 38: ninguna de las dos (0x6000000); otro tipo: falso.
+bool CGarage::RightModTypeForThisGarage(CVehicle* vehicle) {
+    if (!vehicle)
+        return false;
+    const auto* const   modelInfo = CModelInfo::ms_modelInfoPtrs[static_cast<int16>(vehicle->m_nModelIndex)];
+    const uint8         handlingId = GaField<uint8>(modelInfo, 0x4A);
+    const uint32        flags = GaField<uint32>(reinterpret_cast<const uint8*>(gHandlingDataMgr.m_aVehicleHandling.data()) + size_t(handlingId) * 0xE0, 0xD0);
+    switch (static_cast<uint32>(m_nType)) {
+    case 36: return (flags & 0x2000000u) != 0;
+    case 37: return (flags & 0x4000000u) != 0;
+    case 38: return (flags & 0x6000000u) == 0;
+    default: return false;
+    }
+}
+
+// 0x447D80
+// Como el original (0x447D80..0x447E0E): distancia al cuadrado de (x, y) al rectangulo del garaje (izquierda +0x28, derecha +0x2C, frente +0x30, fondo +0x34). Cada eje: antes del borde bajo (comparacion ordenada) x - borde bajo;
+// pasado el alto (comparacion ordenada) x - borde alto; en otro caso (dentro o NaN) 0. dy*dy + dx*dx con los x87 a 24 bits sin guardar a float: se devuelve el valor del registro (el llamador hace el fstp dword).
+double CGarage::CalcDistToGarageRectangleSquared(float x, float y) {
+    const auto axis = [](float v, float low, float high) -> double {
+        if (v < low)
+            return Veh83DSub(v, low);
+        if (v > high)
+            return Veh83DSub(v, high);
+        return 0.0;
+    };
+    const double dx = axis(x, m_fLeftCoord, m_fRightCoord);
+    const double dy = axis(y, m_fFrontCoord, m_fBackCoord);
+    return Veh83DAdd(Veh83DMul(dy, dy), Veh83DMul(dx, dx));
+}
+
+// 0x448550
+// Como el original (0x448550..0x4485B6): para cada uno de los 4 coches guardados con modelo distinto de cero se restaura el vehiculo (CStoredCar::RestoreCar, 0x447E40); si existe, se limpia el bit 5 del byte +0x42D y se anade al mundo
+// (CWorld::Add, 0x563220) y el hueco queda vacio; si no, se deja. Devuelve verdadero si al final los 4 huecos estan vacios.
+bool CGarage::RestoreCarsForThisHideOut(CStoredCar* cars) {
+    for (uint32 i = 0; i < 4; ++i) {
+        if (cars[i].m_wModelIndex == 0)
+            continue;
+        CVehicle* const vehicle = cars[i].RestoreCar();
+        if (!vehicle)
+            continue;
+        GaField<uint8>(vehicle, 0x42D) &= 0xDFu;
+        CWorld::Add(vehicle);
+        cars[i].m_wModelIndex = 0;
+    }
+    for (uint32 i = 0; i < 4; ++i) {
+        if (cars[i].m_wModelIndex != 0)
+            return false;
+    }
+    return true;
+}
+
