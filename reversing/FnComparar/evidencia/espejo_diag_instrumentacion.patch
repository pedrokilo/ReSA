+static void DiagVolcarRaster(RwRaster* r, const char* nombre) {
+    if (!r) return;
+    auto* top = r->parent ? r->parent : r;
+    auto* dev = static_cast<IDirect3DDevice9*>(StaticRef<void*>(0xC97C28));
+    auto* tex = *reinterpret_cast<IDirect3DTexture9**>(reinterpret_cast<uint8*>(top) + StaticRef<int32>(0xB4E9E0));
+    if (!tex || !dev) return;
+    IDirect3DSurface9* surf = nullptr;
+    if (FAILED(tex->GetSurfaceLevel(0, &surf)) || !surf) return;
+    D3DSURFACE_DESC d{};
+    surf->GetDesc(&d);
+    IDirect3DSurface9* sys = nullptr;
+    if (SUCCEEDED(dev->CreateOffscreenPlainSurface(d.Width, d.Height, d.Format, D3DPOOL_SYSTEMMEM, &sys, nullptr))) {
+        if (SUCCEEDED(dev->GetRenderTargetData(surf, sys))) {
+            D3DLOCKED_RECT lr{};
+            if (SUCCEEDED(sys->LockRect(&lr, nullptr, D3DLOCK_READONLY))) {
+                if (FILE* f = fopen(nombre, "wb")) {
+                    uint32 sz = 54 + d.Width * d.Height * 3;
+                    uint8 h[54] = { 'B','M' };
+                    *(uint32*)(h + 2) = sz; *(uint32*)(h + 10) = 54; *(uint32*)(h + 14) = 40;
+                    *(int32*)(h + 18) = (int32)d.Width; *(int32*)(h + 22) = -(int32)d.Height; *(uint16*)(h + 26) = 1; *(uint16*)(h + 28) = 24;
+                    fwrite(h, 1, 54, f);
+                    for (uint32 y = 0; y < d.Height; y++) {
+                        const uint8* row = static_cast<const uint8*>(lr.pBits) + y * lr.Pitch;
+                        for (uint32 x = 0; x < d.Width; x++) { fwrite(row + x * 4, 1, 3, f); }
+                    }
+                    fclose(f);
+                }
+                sys->UnlockRect();
+            }
+        }
+        sys->Release();
+    }
+    surf->Release();
+}
