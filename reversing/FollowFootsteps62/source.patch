 CTask* CTaskComplexFollowPedFootsteps::ControlSubTask(CPed* ped) {
-    return plugin::CallMethodAndReturn<CTask*, 0x695090, CTaskComplexFollowPedFootsteps*, CPed*>(this, ped);
