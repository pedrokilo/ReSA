+            newType                    = TASK_SIMPLE_STAND_STILL;
+        } else if (kFarSq < sqMag) { // 0x870C38; con NaN no entra (jnp tras test ah,5)
+            newType = TASK_COMPLEX_SEEK_ENTITY;
+        } else if (dist2D < 1.0f && std::fabs(D.z) > 2.0f) { // 0x858624 y 0x858CA0
+            newType = TASK_COMPLEX_SEEK_ENTITY;
+        } else {
