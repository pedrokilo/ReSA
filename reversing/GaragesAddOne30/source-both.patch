+        const uint8 type = static_cast<uint8>(aGarages[i].m_nType);
+        if (type < 0x21 || type > 0x23)
+            continue;
+        if (GarageImpoundCloserCpp(&aGarages[i].m_vPosn.x, &vehicle->GetPosition().x, &minDist)) {
+            best = static_cast<int32>(i);
+        }
+    }
+
+    if (best < 0)
