diff --git a/source/game_sa/X87Math.cpp b/source/game_sa/X87Math.cpp
index 0e5aebc..1d6067f 100644
--- a/source/game_sa/X87Math.cpp
+++ b/source/game_sa/X87Math.cpp
@@ -12839,3 +12839,25 @@ __declspec(noinline) void __cdecl QuatSlerpTCpp(float* out, const float* from, c
     QuatSlerpTCalcThetaCpp(from, to, &theta, &invSin);
     QuaternionSlerpCpp(out, from, to, theta, invSin, t);
 }
+
+// --- CGarages::AddOne (0x4471E0) y CGarages::StoreCarInNearestImpoundingGarage (0x44A3C0), lote 30, prefijo Garage ---
+// Cada funcion es noinline: la secuencia x87 (fld/fadd/fsub/fstp, fsqrt, fdiv) no cambia al insertarse en el llamador (que se compila con SSE).
+__declspec(noinline) float __cdecl GarageSumDiffCpp(float a, float b, float c) {
+    volatile float result = float((double(a) + double(b)) - double(c));
+    return result;
+}
+
+__declspec(noinline) float __cdecl GarageDiffCpp(float a, float b) {
+    volatile float result = float(double(a) - double(b));
+    return result;
+}
+
+__declspec(noinline) void __cdecl GarageNormalizeCpp(float x, float y, float* outX, float* outY, float* length) {
+    const double s = sqrt(double(y) * double(y) + double(x) * double(x));
+    volatile float stored = float(s);
+    *length = stored;
+    *outX = float(double(x) / s);
+    const double divisor = stored;
+    *outY = float(double(y) / divisor);
+}
+
diff --git a/source/game_sa/X87Math.h b/source/game_sa/X87Math.h
index f6e1972..9b843bc 100644
--- a/source/game_sa/X87Math.h
+++ b/source/game_sa/X87Math.h
@@ -1523,3 +1523,11 @@ void __cdecl QuaternionFromEulerCpp(float* q, float ax, float ay, float az);
 // --- CQuaternion::Slerp(from, to, t) (0x59C630), prefijo QuatSlerpT. Anadir al FINAL de X87Math.h ---
 // CalcTheta (0x4D00E0, con el _CIacos del EXE en FlcX87) y luego QuaternionSlerpCpp (0x59C300) con (theta, 1/sin(theta), t).
 void __cdecl QuatSlerpTCpp(float* out, const float* from, const float* to, float t);
+
+// --- CGarages::AddOne (0x4471E0) y CGarages::StoreCarInNearestImpoundingGarage (0x44A3C0), lote 30, prefijo Garage ---
+// (a + b) - c con la x87 (24 bits de mantisa, exponente extendido) y un solo guardado a float: cuarta esquina del garaje (fld, fadd, fsub, fstp).
+float __cdecl GarageSumDiffCpp(float a, float b, float c);
+// a - b con la x87 y un solo guardado a float (direcciones del garaje: frontX - x1, x2 - x1...).
+float __cdecl GarageDiffCpp(float a, float b);
+// Normaliza (x, y): s = sqrt(y*y + x*x) sin redondear; *length = float(s); *outX = float(x / s) con s en registro; *outY = float(y / *length) con el float guardado (0x4474E8..0x447570).
+void __cdecl GarageNormalizeCpp(float x, float y, float* outX, float* outY, float* length);
