+    dy = dy - h[1];
+    out[1] = (float)(double)dy;
+    volatile double dx = (double)c[0];
+    dx = dx - h[0];
+    out[0] = (float)(double)dx;
+    volatile double xx = (double)dx;
+    xx = xx * out[0];
+    volatile double yy = (double)out[1];
+    yy = yy * out[1];
