+    const auto nQ = Heli75Op(q, nR, HeatFire73Nan{});
+    const auto nN = Heli75Op(n, Heli75Reg(comp), nQ);
+    const auto nD = Heli75Op(dd, HeatFire73Nan{}, nQ);
+    const auto nRatio = Heli75Op(ratio, nN, nD);
