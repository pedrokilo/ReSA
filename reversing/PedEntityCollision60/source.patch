+        cp.m_vecNormal.Normalise();
+        const CVector& pos = GetPosition();
+        const float nx = cp.m_vecNormal.x * 0.35f; // 0x858F9C
+        const float ny = cp.m_vecNormal.y * 0.35f;
+        const float nz = cp.m_vecNormal.z * 0.35f;
+        cp.m_vecPoint.x = pos.x - nx;
+        cp.m_vecPoint.y = pos.y - ny;
+        cp.m_vecPoint.z = pos.z - nz;
+        ++numCPs;
+        bHitSteepSlope = true;
+    }
+
+    // 0x5E35B4
+    if (numCPs > 0 || maxTouch[0] < kOne) {
+        AddCollisionRecord(entity);
+        if (type != ENTITY_TYPE_BUILDING) {
+            static_cast<CPhysical*>(entity)->AddCollisionRecord(this);
+        }
+        if (numCPs > 0) {
+            if (type == ENTITY_TYPE_BUILDING || entity->GetIsStatic()) {
+                m_bHasHitWall = true;
+            }
+        }
+    }
+    return numCPs;
 }
 
