+    if (numCPs > 0 || maxTouch[0] < kOne) {
+        AddCollisionRecord(entity);
+        if (type != ENTITY_TYPE_BUILDING) {
+            static_cast<CPhysical*>(entity)->AddCollisionRecord(this);
+        }
+        if (numCPs > 0) {
+            if (type == ENTITY_TYPE_BUILDING || entity->GetIsStatic()) {
+                m_bHasHitWall = true;
+            }
+        }
+    }
+    return numCPs;
 }
 
