 // Quat from axis & angle (0x59C600): {sin(a/2) * eje, cos(a/2)} con el seno sin redondear (QuaternionFromAxisAngleCpp, X87Math).
diff --git a/source/game_sa/X87Math.cpp b/source/game_sa/X87Math.cpp
index 5ace44ecd..7fbcf4871 100644
--- a/source/game_sa/X87Math.cpp
+++ b/source/game_sa/X87Math.cpp
@@ -12659,3 +12659,38 @@ __declspec(noinline) unsigned int __cdecl AudioHwPercentPositionCpp(int percent,
     return Ftol2RegsDblCpp(double(floored), 0u).eax; // ECX de entrada: nadie lo lee tras la llamada
 }
 #pragma float_control(pop)
+
+// --- CQuaternion::Set(float, float, float) (0x59C530; lote 29, prefijo QuatEuler) ---
+// El EXE (0x59C530..0x59C5EF): hx = ax*0.5f (0x858B8C), idem hy, hz; cx = cos(hx), cy = cos(hy), cz = cos(hz) (sin redondear salvo cz, que se guarda como float); sx, sy, sz = sin(h) guardados
+// como float; cycx = f(cy*cx), sysx = f(sy*sx), sxcy = f(sx*cy) (cy y cx sin redondear), cxsy = cx*sy (queda en registro, 24 bits);
+// w = f(f(sysx*sz) + f(cycx*cz)), x = f(f(cycx*sz) - f(sysx*cz)), y = f(f(sz*cxsy) + f(sxcy*cz)), z = f(f(cxsy*cz) - f(sxcy*sz)); se escriben en el orden w, x, y, z.
+// Los valores que el EXE guarda como float (fstp dword) son `volatile float`; |h| >= 2^63 deja fsin/fcos el operando intacto (C2), igual que el EXE.
+static double QuatEulerSin(double h) { return (h >= 9223372036854775808.0 || h <= -9223372036854775808.0) ? h : sin(h); }
+static double QuatEulerCos(double h) { return (h >= 9223372036854775808.0 || h <= -9223372036854775808.0) ? h : cos(h); }
+__declspec(noinline) void __cdecl QuaternionFromEulerCpp(float* q, float ax, float ay, float az) {
+    const double hx = double(ax) * 0.5f;
+    const double hy = double(ay) * 0.5f;
+    const double hz = double(az) * 0.5f;
+    const double cx = QuatEulerCos(hx);
+    const double cy = QuatEulerCos(hy);
+    volatile float cz = float(QuatEulerCos(hz));
+    volatile float sx = float(QuatEulerSin(hx));
+    volatile float sy = float(QuatEulerSin(hy));
+    volatile float sz = float(QuatEulerSin(hz));
+    volatile float cycx = float(cy * cx);
+    volatile float sysx = float(double(sy) * double(sx));
+    volatile float sxcy = float(double(sx) * cy);
+    const double cxsy = double(float(cx * double(sy)));
+    volatile float t1 = float(double(sysx) * double(sz));
+    volatile float t2 = float(double(cycx) * double(cz));
+    q[3] = float(double(t1) + double(t2));
+    t1 = float(double(cycx) * double(sz));
+    t2 = float(double(sysx) * double(cz));
+    q[0] = float(double(t1) - double(t2));
+    t1 = float(double(sz) * cxsy);
+    t2 = float(double(sxcy) * double(cz));
+    q[1] = float(double(t1) + double(t2));
+    t1 = float(cxsy * double(cz));
+    t2 = float(double(sxcy) * double(sz));
+    q[2] = float(double(t1) - double(t2));
+}
