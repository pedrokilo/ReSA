+float GeometryPlaneOffset(const CVector* plane, const CVector* previous) {
+    float result;
+    // 0x5F16EC..0x5F171B: retain x87 products/sums until the final float store.
+    __asm {
+        mov ecx, plane
+        mov edx, previous
+        fld dword ptr [edx+8]
+        fmul dword ptr [ecx+8]
+        fld dword ptr [edx+4]
+        fmul dword ptr [ecx+4]
+        faddp st(1), st
+        fld dword ptr [edx]
+        fmul dword ptr [ecx]
+        faddp st(1), st
+        fchs
+        fstp result
+    }
+    return result;
+}
