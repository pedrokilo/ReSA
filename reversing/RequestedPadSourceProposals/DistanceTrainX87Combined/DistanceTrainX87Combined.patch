+// x87 ST(0) input, EDX:EAX truncated integer output; native 0x821B40 arithmetic.
+// Called only by the shake arithmetic block; no delegate to the original EXE.
+static __declspec(naked) int64 __cdecl PadShakeFloatToInteger() {
+    __asm {
+        push ebp
+        mov ebp, esp
+        sub esp, 20h
+        and esp, 0FFFFFFF0h
+        fld st(0)
+        fst dword ptr [esp + 18h]
+        fistp qword ptr [esp + 10h]
+        fild qword ptr [esp + 10h]
+        mov edx, dword ptr [esp + 18h]
+        mov eax, dword ptr [esp + 10h]
+        test eax, eax
+        je shake_ftol_zero
+        shake_ftol_adjust:
+        fsubp st(1), st(0)
+        test edx, edx
+        jns shake_ftol_positive
+        fstp dword ptr [esp]
+        mov ecx, dword ptr [esp]
+        xor ecx, 80000000h
+        add ecx, 7FFFFFFFh
+        adc eax, 0
+        mov edx, dword ptr [esp + 14h]
+        adc edx, 0
+        jmp shake_ftol_done
+        shake_ftol_positive:
+        fstp dword ptr [esp]
+        mov ecx, dword ptr [esp]
+        add ecx, 7FFFFFFFh
+        sbb eax, 0
+        mov edx, dword ptr [esp + 14h]
+        sbb edx, 0
+        jmp shake_ftol_done
+        shake_ftol_zero:
+        mov edx, dword ptr [esp + 14h]
+        test edx, 7FFFFFFFh
+        jne shake_ftol_adjust
+        fstp dword ptr [esp + 18h]
+        fstp dword ptr [esp + 18h]
+        shake_ftol_done:
+        leave
+        ret
+    }
+}
