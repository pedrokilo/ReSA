  "source_helper_assembly": " {\n    __asm {\n        push ebp\n        mov ebp, esp\n        sub esp, 20h\n        and esp, 0FFFFFFF0h\n        fld st(0)\n        fst dword ptr [esp + 18h]\n        fistp qword ptr [esp + 10h]\n        fild qword ptr [esp + 10h]\n        mov edx, dword ptr [esp + 18h]\n        mov eax, dword ptr [esp + 10h]\n        test eax, eax\n        je shake_ftol_zero\n        shake_ftol_adjust:\n        fsubp st(1), st(0)\n        test edx, edx\n        jns shake_ftol_positive\n        fstp dword ptr [esp]\n        mov ecx, dword ptr [esp]\n        xor ecx, 80000000h\n        add ecx, 7FFFFFFFh\n        adc eax, 0\n        mov edx, dword ptr [esp + 14h]\n        adc edx, 0\n        jmp shake_ftol_done\n        shake_ftol_positive:\n        fstp dword ptr [esp]\n        mov ecx, dword ptr [esp]\n        add ecx, 7FFFFFFFh\n        sbb eax, 0\n        mov edx, dword ptr [esp + 14h]\n        sbb edx, 0\n        jmp shake_ftol_done\n        shake_ftol_zero:\n        mov edx, dword ptr [esp + 14h]\n        test edx, 7FFFFFFFh\n        jne shake_ftol_adjust\n        fstp dword ptr [esp + 18h]\n        fstp dword ptr [esp + 18h]\n        shake_ftol_done:\n        leave\n        ret\n    }\n}\n\n",
