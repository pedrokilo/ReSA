+void StatsLineTail(const char* key) {
+    const GxtChar* const text = TheText.Get(key);
+    GxtCharStrcpy(gGxtString, text);
+    StatsStripTags(gGxtString);
+    AsciiToGxtChar(gString2, gGxtString2);
