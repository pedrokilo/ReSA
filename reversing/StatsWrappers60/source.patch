+// Cola 0x55B68F: el texto de la clave a gGxtString2 (el llamador pone antes gGxtString[0] = 0).
+void StatsLineTailKey(const char* key) {
+    const GxtChar* const text = TheText.Get(key);
+    GxtCharStrcpy(gGxtString2, text);
+}
