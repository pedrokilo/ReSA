+namespace {
+// The executable statically links a different CRT. Keep its FILE ownership and
+// redirect only this thread's current UTF-8 fopen request to CreateFileW.
+thread_local const char* nativeOpenPath{};
+thread_local const wchar_t* nativeOpenWidePath{};
+using CreateFileAFn = HANDLE(WINAPI*)(LPCSTR,DWORD,DWORD,LPSECURITY_ATTRIBUTES,DWORD,DWORD,HANDLE);
+CreateFileAFn originalCreateFileA{};
+HANDLE WINAPI CreateNativeFile(LPCSTR path,DWORD access,DWORD share,LPSECURITY_ATTRIBUTES security,DWORD creation,DWORD flags,HANDLE templ) {
+    if (nativeOpenPath && path && std::strcmp(path,nativeOpenPath)==0) {
+        return CreateFileW(nativeOpenWidePath,access,share,security,creation,flags,templ);
+    }
+    return originalCreateFileA(path,access,share,security,creation,flags,templ);
+}
+struct NativeOpenPath {
+    const char* previousPath = nativeOpenPath;
+    const wchar_t* previousWidePath = nativeOpenWidePath;
+    std::wstring widePath;
+    explicit NativeOpenPath(const char* path) : widePath(UTF8ToUnicode(path)) {
+        static std::once_flag installed;
+        std::call_once(installed, [] {
+            auto** entry = reinterpret_cast<void**>(0x8580A0);
+            DWORD old{};
+            VERIFY(VirtualProtect(entry,sizeof(*entry),PAGE_READWRITE,&old));
+            originalCreateFileA = reinterpret_cast<CreateFileAFn>(*entry);
+            InterlockedExchangePointer(entry,reinterpret_cast<void*>(&CreateNativeFile));
+            DWORD ignored{};
+            VERIFY(VirtualProtect(entry,sizeof(*entry),old,&ignored));
+        });
+        nativeOpenPath=path;
+        nativeOpenWidePath=widePath.c_str();
+    }
+    ~NativeOpenPath() { nativeOpenPath=previousPath; nativeOpenWidePath=previousWidePath; }
+};
+struct NativeFileFunctions {
+    void* beforeSeek[8];
+    int (__cdecl* seek)(FILESTREAM,long,int);
+    void* flush;
+    int (__cdecl* tell)(FILESTREAM);
+};
+NativeFileFunctions* FileFunctions() { return plugin::CallAndReturn<NativeFileFunctions*,0x804130>(); }
+}
