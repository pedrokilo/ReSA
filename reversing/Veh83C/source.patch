+static __declspec(noinline) int32_t __cdecl Veh83CFtolD(double v) {
+    if (!(std::fabs(v) < 9223372036854775808.0)) {
+        return 0;
+    }
+    return static_cast<int32_t>(static_cast<uint32_t>(static_cast<uint64_t>(static_cast<int64_t>(v))));
