+    const WaterLevelVertexCpp& v1 = verts[short(quad[1])];
+    const WaterLevelVertexCpp& v2 = verts[short(quad[2])];
+    return double(v0.x) <= double(out[0]) && double(v1.x) >= double(out[0]) && double(v0.y) <= double(out[1]) && double(v2.y) >= double(out[1]);
