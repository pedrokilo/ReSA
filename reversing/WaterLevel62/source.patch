+// 0x6EDDDF..0x6EDE33: centro (x, y) = suma de enteros por 0.3333333134651184 (0x8594EC) y radio = (X2 - X1) * 0.71f (0x872168).
+__declspec(noinline) void __cdecl Water62TriSphereCpp(int x1, int x2, int x3, int y1, int y2, int y3, float* center, float* radius) {
+    const float third = std::bit_cast<float>(0x3EAAAAAAu);   // 0x8594EC
+    const float scale = 0.71f;                               // 0x872168
