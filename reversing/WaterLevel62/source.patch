+// Orden de escrituras como el EXE: profundidad (nivel - suelo con fld/fsub/fstp), nivel (copia de 32 bits sin pasar por la x87) y suelo (fld/fstp: un SNaN sale silenciado).
+__declspec(noinline) void __cdecl Water62DepthStoreCpp(const unsigned int* levelSlot, const float* groundSlot, float* outDepth, unsigned int* outLevel, float* outGround) {
+    const double ground = groundSlot ? double(*groundSlot) : -100.0;
+    if (outDepth) {
+        *outDepth = float(double(*reinterpret_cast<const float*>(levelSlot)) - ground);
+    }
