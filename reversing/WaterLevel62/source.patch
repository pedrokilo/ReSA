+    const double tz = double(dz) * double(t);
+    out[0] = float(double(tdx) + double(from[0]));
+    out[1] = float(ty + double(from[1]));
+    out[2] = float(tz + double(from[2]));
+}
+// Prueba de la caja del cuadrilatero: x0 <= X <= x1 e y0 <= Y <= y2 (vertices 0, 1, 2), comparaciones ordenadas (NaN no pasa).
+static __forceinline bool Water62InQuad(const unsigned short* quad, const WaterLevelVertexCpp* verts, const float* out) {
