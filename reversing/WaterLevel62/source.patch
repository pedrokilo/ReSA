+    const float yMin = from[1] < to[1] ? from[1] : to[1];
+    const float zMax = from[2] > to[2] ? from[2] : to[2];
+    const float yMax = from[1] > to[1] ? from[1] : to[1];
+    const float xMin = from[0] < to[0] ? from[0] : to[0];
+    const float xMax = from[0] > to[0] ? from[0] : to[0];
+    const int bMinY = Water62Block(yMin);
+    const int bMaxX = Water62Block(xMax);
+    const int bMaxY = Water62Block(yMax);
+    const int bMinX = Water62Block(xMin);
+    for (int ix = bMinX; ix <= bMaxX; ++ix) {
+        const int row = int(unsigned(ix) * 12u);
+        for (int iy = bMinY; iy <= bMaxY; ++iy) {
