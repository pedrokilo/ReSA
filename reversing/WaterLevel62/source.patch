+    center[1] = float(double(int(unsigned(y1) + unsigned(y2))) * 0.5);
+    const double hx = double(int(unsigned(maxX) - unsigned(minX))) * 0.5;
+    const double hy = double(int(unsigned(y1) - unsigned(y2))) * 0.5;
+    const double sum = hy * hy + hx * hx;
+    *radius = float(Water62RootCpp(sum));
